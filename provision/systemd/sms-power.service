[Unit]
Description=Mesh Stack - battery monitor (Waveshare UPS HAT (D) INA219) + low-voltage cutoff
After=multi-user.target

[Service]
Type=simple
User=mesh
WorkingDirectory=/opt/mesh-stack
Environment=SMS_DB=/opt/mesh-stack/telemetry.sqlite
Environment=SMS_POWER_JSON=/opt/mesh-stack/power.json
Environment=SMS_INA219_ADDR=0x43
Environment=SMS_BATT_WARN_V=3.6
Environment=SMS_BATT_CRIT_V=3.4
Environment=SMS_BATT_FLOOR_V=3.3
# channel index for the low-battery warning message; empty = log only
Environment=SMS_WEB_SEND_TARGET=
EnvironmentFile=-/etc/mesh-stack/stack.env
ExecStart=/opt/mesh-stack/venv/bin/python /opt/mesh-stack/power.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
