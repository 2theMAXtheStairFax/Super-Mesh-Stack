[Unit]
Description=Mesh Stack - walk-up web UI (Messages / Weather / Config / Flash)
After=multi-user.target

[Service]
Type=simple
User=mesh
WorkingDirectory=/opt/mesh-stack
Environment=SMS_DIR=/opt/mesh-stack
Environment=SMS_WEB_PORT=80
EnvironmentFile=-/etc/mesh-stack/stack.env
ExecStart=/opt/mesh-stack/venv/bin/python /opt/mesh-stack/web.py
# lets a non-root service bind :80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
