   bool handleCommand(const char* command, uint32_t sender_timestamp, char* reply) override {
+    // SFM: "ui next|prev|enter|select|wake" - the Pi's joystick drives this screen
+    if (memcmp(command, "time force ", 11) == 0) {
+      unsigned long t = strtoul(&command[11], NULL, 10);
+      if (t < 1700000000UL) {
+        strcpy(reply, "Error, bad epoch");
+        return true;
+      }
+      g_force_time = (uint32_t)t;
+      strcpy(reply, "OK");
+      return true;
+    }
+    if (strcmp(command, "ui msgwake on") == 0 || strcmp(command, "ui msgwake off") == 0) {
+      g_ui_msg_wake = command[13] == 'n';
+      strcpy(reply, "OK");
+      return true;
+    }
+    if (memcmp(command, "ui ", 3) == 0) {
+      const char* k = &command[3];
+      char code = strcmp(k, "next") == 0 ? 'n' : strcmp(k, "prev") == 0 ? 'p' :
+                  strcmp(k, "enter") == 0 ? 'e' : strcmp(k, "select") == 0 ? 's' :
+                  strcmp(k, "wake") == 0 ? 'w' : 0;
+      if (!code) {
+        strcpy(reply, "Error, ui next|prev|enter|select|wake");
+        return true;
+      }
+      g_ui_inject_key = code;
+      strcpy(reply, "OK");
+      return true;
+    }
     if (memcmp(command, "set ext.batt ", 13) == 0) {
       const char* p = &command[13];
       long mv = strtol(p, (char**)&p, 10);
