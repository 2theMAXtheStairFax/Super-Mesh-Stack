+// SFM: backlight with brightness - PWM on the LEDA pin below 100 %
+void ST7789Display::writeBacklight(bool on) {
+#ifdef PIN_TFT_LEDA_CTL_ACTIVE
+  const bool active_high = PIN_TFT_LEDA_CTL_ACTIVE == HIGH;
+#else
+  const bool active_high = false;   // T114: LOW = backlight on
+#endif
+  int level = on ? (int)_bright * 255 / 100 : 0;
+  if (_pwm_used || (on && _bright < 100)) {
+    analogWrite(PIN_TFT_LEDA_CTL, active_high ? level : 255 - level);
+    _pwm_used = true;
+  } else {
+    digitalWrite(PIN_TFT_LEDA_CTL, on == active_high ? HIGH : LOW);
+  }
+}
+
+void ST7789Display::setBrightness(uint8_t pct) {
+  if (pct < 5) pct = 5;
+  if (pct > 100) pct = 100;
+  if (pct == _bright) return;
+  _bright = pct;
+  if (_isOn) writeBacklight(true);
+}
