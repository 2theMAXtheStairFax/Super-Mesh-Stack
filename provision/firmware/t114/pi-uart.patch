diff --git a/variants/heltec_t114/variant.h b/variants/heltec_t114/variant.h
index 6e12447..f4036cd 100644
--- a/variants/heltec_t114/variant.h
+++ b/variants/heltec_t114/variant.h
@@ -52,8 +52,10 @@
 #define PIN_SERIAL1_RX          (37)
 #define PIN_SERIAL1_TX          (39)
 
-#define PIN_SERIAL2_RX          (9)
-#define PIN_SERIAL2_TX          (10)
+// SFM: Serial2 is the companion link to the Pi (P1 header). GPIO9/10 belong
+// to the GPS on Serial1, so Serial2 moves to P1-8 (P1.01) / P1-6 (P0.16).
+#define PIN_SERIAL2_RX          (33)  // P1.01, P1-8 <- Pi TXD (GPIO14, pin 8)
+#define PIN_SERIAL2_TX          (16)  // P0.16, P1-6 -> Pi RXD (GPIO15, pin 10)
 
 ////////////////////////////////////////////////////////////////////////////////
 // I2C pin definition
