   -D ENABLE_USB_INTERFACE
   -D ENV_INCLUDE_GPS=1   ; enable the GPS page in UI
+  -D SERIAL_RX=PIN_SERIAL2_RX   ; SFM: companion protocol to the Pi over UART too
+  -D SERIAL_TX=PIN_SERIAL2_TX
