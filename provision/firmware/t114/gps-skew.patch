index 0dc892c..6782bda 100644
--- a/src/helpers/sensors/EnvironmentSensorManager.cpp
+++ b/src/helpers/sensors/EnvironmentSensorManager.cpp
@@ -923,6 +923,28 @@ void EnvironmentSensorManager::stop_gps() {
 }
 #endif // ENV_INCLUDE_GPS
 
+#ifdef GPS_SKEW
+// SFM: "gps skew on|off" (T114Board) - shift the shared GPS position 200 m on a
+// bearing picked fresh each time skew turns on. A fixed offset, not per-fix
+// jitter, so averaging many adverts doesn't walk back to the real spot.
+extern volatile bool g_gps_skew;
+#define GPS_SKEW_M 200.0
+
+static void applyGpsSkew(double& lat, double& lon) {
+  static bool was_on = false;
+  static double bearing = 0;
+  if (!g_gps_skew) { was_on = false; return; }
+  if (!was_on) {    // timing of the first skewed fix + the fix itself: no RNG state to share
+    uint32_t h = micros() ^ ((uint32_t)(lat * 1e7) * 2654435761UL) ^ (uint32_t)(lon * 1e7);
+    h ^= h >> 16; h *= 0x7feb352dUL; h ^= h >> 15;
+    bearing = (h % 3600) * (PI / 1800.0);
+    was_on = true;
+  }
+  lon += (GPS_SKEW_M * sin(bearing)) / (111320.0 * cos(lat * PI / 180.0));
+  lat += (GPS_SKEW_M * cos(bearing)) / 111320.0;
+}
+#endif
+
 #if ENV_INCLUDE_GPS || defined(ENV_INCLUDE_BME680_BSEC)
 void EnvironmentSensorManager::loop() {
 
@@ -946,6 +968,9 @@ void EnvironmentSensorManager::loop() {
     if (_location->isValid()) {
       node_lat = ((double)_location->getLatitude())/1000000.;
       node_lon = ((double)_location->getLongitude())/1000000.;
+      #ifdef GPS_SKEW
+      applyGpsSkew(node_lat, node_lon);
+      #endif
       MESH_DEBUG_PRINTLN("lat %f lon %f", node_lat, node_lon);
       node_altitude = ((double)_location->getAltitude()) / 1000.0;
       MESH_DEBUG_PRINTLN("lat %f lon %f alt %f", node_lat, node_lon, node_altitude);
