+#ifdef GPS_FIX_CMD
+// SFM: "gps fix" (T114Board) - lock state for the Pi. A valid fix only counts while
+// its GPS time keeps moving on, so a module that goes quiet doesn't read as locked.
+extern volatile bool g_gps_valid;
+extern volatile uint8_t g_gps_sats;
+extern volatile uint32_t g_gps_fix_ms;
+
+static void publishGpsFix(LocationProvider* loc) {
+  static long last_ts = 0;
+  g_gps_valid = loc->isValid();
+  g_gps_sats = (uint8_t)constrain(loc->satellitesCount(), 0, 255);
+  long ts = loc->getTimestamp();
+  if (g_gps_valid && ts != last_ts) {
+    last_ts = ts;
+    uint32_t now = millis();
+    g_gps_fix_ms = now ? now : 1;
+  }
+}
+#endif
+
